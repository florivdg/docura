{
  "$schema": "./node_modules/fallow/schema.json",

  // Entry points (pages, endpoints, layouts, middleware, astro.config) come from
  // fallow's astro plugin; CLI scripts are picked up via package.json scripts.

  // The @astrojs/* and Vite plugins are only imported by astro.config.mjs, which
  // fallow treats as non-production and would report as "test only".
  // `postgres` is never imported: drizzle-kit needs a recognized driver package
  // to connect, while the app itself uses bun:sql (see README).
  "ignoreDependencies": [
    "@astrojs/node",
    "@astrojs/vue",
    "@tailwindcss/vite",
    "postgres",
  ],

  // src/components/ui is generated by shadcn-vue and must not be edited by hand.
  // Keep it in the module graph (so its imports keep deps and exports alive) but
  // hide its own findings: unused barrel re-exports, cycles, complexity, dupes.
  "ignoreFindings": ["src/components/ui/**"],
  "duplicates": {
    "ignore": ["src/components/ui/**"],
  },
  "health": {
    // global.css is the theme generated by `shadcn-vue init`; a full token
    // palette is expected to contain tokens nothing uses yet.
    "ignore": ["src/components/ui/**", "src/styles/global.css"],
    // Vue/Astro templates are measured as one synthetic unit; plain markup trips
    // the default 60-line limit on length alone.
    "thresholdOverrides": [
      {
        "files": ["src/**/*.vue", "src/**/*.astro"],
        "maxUnitSize": 150,
        "reason": "templates are markup, not logic",
      },
    ],
  },

  // Gate every finding in changed files, not only newly introduced ones:
  // touching a hotspot means leaving it cleaner than it was.
  "audit": {
    "gate": "all",
  },
}
