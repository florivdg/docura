DATABASE_URL=postgresql://docura:docura_dev_password@localhost:5433/docura
BETTER_AUTH_SECRET=<32-byte-base64-secret>
BETTER_AUTH_URL=http://localhost:4321
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:4321
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
OLLAMA_URL=http://localhost:11434
# Changing the embedding model needs a migration and re-embedding; see README,
# "Changing the embedding model". Its dimension must match EMBEDDING_DIMENSIONS
# in src/db/schema/embedding.ts (1024 for mxbai-embed-large).
OLLAMA_EMBED_MODEL=mxbai-embed-large
OLLAMA_LLM_MODEL=llama3
OCR_SERVICE_URL=http://localhost:8100
REDIS_URL=redis://localhost:6379
WATCH_DIR=./watch
WATCH_ENABLED=true
TRASH_RETENTION_DAYS=90
# Parallel job workers per worker process
WORKER_CONCURRENCY=2
# A job without a worker heartbeat for this long is reset and retried
# (minimum 2; missing, invalid or smaller values fall back to 10)
STALE_JOB_TIMEOUT_MINUTES=10
