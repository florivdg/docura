# Docura production settings for docker-compose.yml.
# Copy to .env next to docker-compose.yml: cp .env.production.example .env
# How compose uses this file: README, "Deployment". Commented-out values are
# the defaults.

# --- Required -----------------------------------------------------------------

# Host name of the server in the LAN (DNS or hosts entry pointing to its IP).
# Used for the HTTPS certificate, BETTER_AUTH_URL and the passkey origin;
# passkeys are bound to it, so changing it later invalidates them.
DOCURA_HOST=docura.lan
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Password of the PostgreSQL user (used only inside the compose network).
# Letters and digits only (A-Z, a-z, 0-9): it is inserted unencoded into
# DATABASE_URL, and compose interpolates `$`. The command below produces such
# a value. PostgreSQL reads it only when the db_data volume is created;
# changing it later does not change the password of an existing database.
# openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=
# Same rule (letters and digits) for user and database name.
# POSTGRES_USER=docura
# POSTGRES_DB=docura

# --- Ports (testing only) -----------------------------------------------------

# Keep 80/443 in production: the HTTP→HTTPS redirect always targets 443.
# For a test next to another web server, set other ports and DOCURA_PUBLIC_URL
# to the resulting origin, e.g. https://docura.localhost:8443.
# DOCURA_HTTP_PORT=80
# DOCURA_HTTPS_PORT=443
# DOCURA_PUBLIC_URL=

# --- Ollama -------------------------------------------------------------------

# Ollama on the Docker host must listen on all interfaces (OLLAMA_HOST=0.0.0.0).
# OLLAMA_URL=http://host.docker.internal:11434
# Changing the embedding model needs a migration and re-embedding; see README,
# "Changing the embedding model".
# OLLAMA_EMBED_MODEL=mxbai-embed-large
# OLLAMA_LLM_MODEL=llama3

# --- Uploads ------------------------------------------------------------------

# MAX_FILE_SIZE_MB=50
# Caddy's request limit; must exceed MAX_FILE_SIZE_MB (multipart overhead).
# DOCURA_MAX_BODY_SIZE=64MB

# --- Watch folder -------------------------------------------------------------

# Host directory scanned by the worker (e.g. scanner or SMB share target).
# Create it before the first start and, on Linux, make it writable for
# uid 1000: mkdir -p <path> && sudo chown -R 1000:1000 <path>
# DOCURA_WATCH_PATH=./watch
# WATCH_ENABLED=true

# --- Backups ------------------------------------------------------------------

# Host directory for the daily backups of the `backup` service (root-owned,
# owner-only). Daily at BACKUP_TIME (HH:MM, UTC); keeps the newest N (0 = all).
# DOCURA_BACKUP_PATH=./backups
# BACKUP_TIME=03:00
# BACKUP_RETENTION_COUNT=14

# --- Worker -------------------------------------------------------------------

# WORKER_CONCURRENCY=2
# Days in the trash before permanent deletion (values <= 0 fall back to 90)
# TRASH_RETENTION_DAYS=90
# A job without a worker heartbeat for this long is reset and retried (min. 2)
# STALE_JOB_TIMEOUT_MINUTES=10

# --- Maintenance and export ---------------------------------------------------

# storage:check never deletes orphan files younger than this (uploads in flight)
# STORAGE_ORPHAN_MIN_AGE_MINUTES=60
# Upper bound for a ZIP export from the web UI
# EXPORT_MAX_DOCUMENTS=10000

# --- Mail (password reset) ----------------------------------------------------

# Password reset by e-mail is only offered when SMTP_HOST is set; SMTP_FROM
# is required then.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=docura@example.com
