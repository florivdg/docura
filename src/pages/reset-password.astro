---
import AuthLayout from '@/layouts/AuthLayout.astro'
import ResetPasswordForm from '@/components/ResetPasswordForm.vue'
import { isSmtpConfigured } from '@/lib/email'

// Without SMTP no reset link can be delivered, so requesting one is pointless.
if (!isSmtpConfigured() && !Astro.url.searchParams.has('token')) {
  return Astro.redirect('/login')
}
---

<AuthLayout title="Passwort zurücksetzen - Docura">
  <ResetPasswordForm client:only="vue" class="w-full max-w-sm" />
</AuthLayout>
